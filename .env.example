# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# The platform host, WITH port in development. Tenant resolution compares the
# request Host against this: an exact match is the platform, "<x>.<this>" is a
# platform subdomain tenant, anything else is a custom domain lookup.
PLATFORM_HOST=unilanding.local:3000
PUBLIC_BASE_URL=http://unilanding.local:3000

# Extra hostnames that mean "the platform itself", comma separated.
# Loopback names are included by default so http://localhost:3000 works with no
# setup. Clear this in production so only the real platform host matches.
PLATFORM_HOST_ALIASES=localhost,127.0.0.1,::1

# Reverse-proxy hops in front of this app, so X-Forwarded-For yields the real
# customer IP (sent to Meta as a match key, so a wrong value costs attribution)
# and X-Forwarded-Host yields the tenant's domain. Hop count ("1") or an
# express expression ("loopback").
TRUST_PROXY=1

# Comma-separated allowed origins. Empty reflects any origin (dev only).
CORS_ORIGINS=http://unilanding.local:3000

# ─── Database ────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/unilanding

# ─── Auth & crypto ───────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_SECRET=replace-me-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d

# AES-256-GCM key for tenant integration secrets at rest (courier/SMS/CAPI
# tokens). Exactly 32 bytes, base64: openssl rand -base64 32
# Rotating this makes every stored tenant secret undecryptable — treat as permanent.
SETTINGS_ENC_KEY=replace-me-with-32-bytes-base64-encoded==

# Session cookie Secure flag. false for http:// local dev, true in production.
COOKIE_SECURE=false

# Shared secret for /api/internal/* (host resolution, cache busting). The Next
# client sends it as X-Internal-Key. These routes are deliberately NOT exposed
# through the Next rewrite. openssl rand -hex 24
INTERNAL_API_KEY=replace-me-dev-internal-key

# ─── Cloudinary (image uploads) ──────────────────────────────────────────────
# Dashboard → Product Environment Credentials. Uploads return a clear error
# while these are unset; nothing else breaks.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=unilanding

# ─── SMTP (transactional email) ──────────────────────────────────────────────
# Unset = email becomes a logged no-op, so order creation still succeeds.
# For Gmail use an App Password, not the account password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=UniLanding <no-reply@unilanding.com>

# ─── Integration defaults ────────────────────────────────────────────────────
# Per-tenant credentials live in TenantSettings (encrypted) and take
# precedence; these are only endpoint/version defaults.
BD_SMS_API_URL=https://api.bdbulksms.net/api.php
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
META_GRAPH_API_VERSION=v21.0

# ─── Seed (npm run seed) ─────────────────────────────────────────────────────
SEED_OWNER_NAME=Platform Owner
SEED_OWNER_EMAIL=owner@unilanding.com
# Leave blank to have a strong password generated and printed once.
SEED_OWNER_PASSWORD=

# ─── Demo tenant (npm run seed:demo) ─────────────────────────────────────────
# Optional. Blank generates a password, printed once, changed at first sign-in.
DEMO_OWNER_EMAIL=owner@milkready.local
DEMO_OWNER_PASSWORD=
